# Copy this file to .env and fill in real values:  cp .env.example .env

# development | production  (tests set "test" automatically)
NODE_ENV=development
PORT=3000

# MongoDB connection string — local or MongoDB Atlas
# DATABASE_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/movie-api?retryWrites=true&w=majority
DATABASE_URI=mongodb://127.0.0.1:27017/movie-api

# JWT — use a long random string, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Optional
# Comma-separated list of allowed CORS origins (defaults to all origins)
# CORS_ORIGIN=http://localhost:5173,https://my-frontend.app
# Max requests per IP per hour on /api (default 300)
# RATE_LIMIT_MAX=300

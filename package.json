{
  "name": "movie-api",
  "version": "1.0.0",
  "description": "Production-ready REST API for movies, actors, reviews and watchlists — Node.js, Express, MongoDB, JWT auth, OpenAPI docs and integration tests.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "data:import": "node dev-data/import-dev-data.js --import",
    "data:delete": "node dev-data/import-dev-data.js --delete",
    "data:reset": "node dev-data/import-dev-data.js --reset"
  },
  "keywords": [
    "rest-api",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "nodejs",
    "openapi",
    "swagger",
    "jest"
  ],
  "author": "sebi-development",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/helpers/env.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "middleware/**/*.js",
      "models/**/*.js",
      "routes/**/*.js",
      "utils/**/*.js",
      "app.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.1",
    "slugify": "^1.6.6",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.26",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "neostandard": "^0.13.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebi-development/movie-api.git"
  }
}
